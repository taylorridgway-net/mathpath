{
  "schemaVersion": 1,
  "domain": {
    "id": "alg",
    "name": "Pre-algebra"
  },
  "skills": [
    {
      "id": "alg.order-ops",
      "name": "Order of operations",
      "summary": "Evaluate expressions with several operations: multiplication and division before addition and subtraction, left to right, parentheses first.",
      "typicalGrade": 6,
      "standards": [
        "5.OA.A.1",
        "6.EE.A.2c"
      ],
      "status": "draft",
      "prerequisites": [],
      "subskills": [
        {
          "id": "alg.order-ops.no-parens",
          "name": "Multiply and divide before adding and subtracting (2 + 3 × 4)",
          "prerequisites": [
            {
              "id": "whole.mult-div.mult-facts",
              "strength": "essential"
            },
            {
              "id": "whole.mult-div.div-facts",
              "strength": "supporting",
              "why": "The hardest problems divide too."
            }
          ]
        },
        {
          "id": "alg.order-ops.parens",
          "name": "Parentheses first ((2 + 3) × 4)",
          "prerequisites": [
            {
              "id": "alg.order-ops.no-parens",
              "strength": "essential",
              "why": "Inside and around the parentheses, the usual order still applies."
            }
          ]
        },
        {
          "id": "alg.order-ops.integers",
          "name": "Order of operations with negative numbers (−2 + 3 × (−4))",
          "prerequisites": [
            {
              "id": "alg.order-ops.no-parens",
              "strength": "essential"
            },
            {
              "id": "int.add-sub.same-sign",
              "strength": "essential"
            },
            {
              "id": "int.add-sub.different-signs",
              "strength": "essential"
            },
            {
              "id": "int.add-sub.subtract",
              "strength": "essential"
            },
            {
              "id": "int.mult-div.multiply",
              "strength": "essential"
            }
          ]
        }
      ]
    },
    {
      "id": "alg.exponents",
      "name": "Exponents",
      "summary": "Evaluate powers with whole-number exponents (including 0), negative bases, and powers inside longer expressions.",
      "typicalGrade": 6,
      "standards": [
        "6.EE.A.1",
        "8.EE.A.1"
      ],
      "status": "draft",
      "prerequisites": [],
      "subskills": [
        {
          "id": "alg.exponents.evaluate",
          "name": "Evaluate a power (2⁴, 5³, 7⁰)",
          "prerequisites": [
            {
              "id": "whole.mult-div.mult-facts",
              "strength": "essential"
            }
          ]
        },
        {
          "id": "alg.exponents.negative-base",
          "name": "Negative bases: (−3)² versus −3²",
          "prerequisites": [
            {
              "id": "alg.exponents.evaluate",
              "strength": "essential"
            },
            {
              "id": "int.mult-div.multiply",
              "strength": "essential"
            }
          ]
        },
        {
          "id": "alg.exponents.in-order",
          "name": "Powers in the order of operations (2 + 3², (2 + 3)²)",
          "prerequisites": [
            {
              "id": "alg.exponents.evaluate",
              "strength": "essential"
            },
            {
              "id": "alg.order-ops.no-parens",
              "strength": "essential"
            }
          ]
        }
      ]
    },
    {
      "id": "alg.equations",
      "name": "Solve one- and two-step equations",
      "summary": "Solve equations by undoing what was done to x, doing the same to both sides; whole numbers, negatives, and fractions at the hardest level.",
      "typicalGrade": 7,
      "standards": [
        "6.EE.B.7",
        "7.EE.B.4a"
      ],
      "status": "draft",
      "prerequisites": [],
      "subskills": [
        {
          "id": "alg.equations.add-sub",
          "name": "Undo adding or subtracting (x + 5 = 12)",
          "prerequisites": [
            {
              "id": "int.add-sub.subtract",
              "strength": "essential"
            },
            {
              "id": "int.add-sub.different-signs",
              "strength": "essential"
            },
            {
              "id": "frac.add-sub",
              "strength": "supporting",
              "why": "The hardest ones have fractions."
            }
          ]
        },
        {
          "id": "alg.equations.mult-div",
          "name": "Undo multiplying or dividing (3x = 21, x/4 = 6)",
          "prerequisites": [
            {
              "id": "whole.mult-div.div-facts",
              "strength": "essential"
            },
            {
              "id": "int.mult-div.divide",
              "strength": "essential"
            },
            {
              "id": "frac.divide",
              "strength": "supporting",
              "why": "The hardest ones have a fraction in front of x."
            }
          ]
        },
        {
          "id": "alg.equations.two-step",
          "name": "Two steps: undo adding or subtracting first, then multiplying or dividing (3x + 5 = 20)",
          "prerequisites": [
            {
              "id": "alg.equations.add-sub",
              "strength": "essential"
            },
            {
              "id": "alg.equations.mult-div",
              "strength": "essential"
            }
          ]
        }
      ]
    },
    {
      "id": "alg.expressions",
      "name": "Simplify expressions",
      "summary": "Combine like terms and use the distributive property to write an expression as simply as possible (ax + b).",
      "typicalGrade": 7,
      "standards": [
        "6.EE.A.3",
        "7.EE.A.1"
      ],
      "status": "draft",
      "prerequisites": [],
      "subskills": [
        {
          "id": "alg.expressions.like-terms",
          "name": "Combine like terms (4x + 3 − x + 7)",
          "prerequisites": [
            {
              "id": "int.add-sub.same-sign",
              "strength": "essential"
            },
            {
              "id": "int.add-sub.different-signs",
              "strength": "essential"
            },
            {
              "id": "int.add-sub.subtract",
              "strength": "essential"
            }
          ]
        },
        {
          "id": "alg.expressions.distribute",
          "name": "Use the distributive property (3(x + 4), −2(x − 5))",
          "prerequisites": [
            {
              "id": "whole.mult-div.mult-facts",
              "strength": "essential"
            },
            {
              "id": "int.mult-div.multiply",
              "strength": "essential"
            }
          ]
        }
      ]
    },
    {
      "id": "alg.multi-step",
      "name": "Multi-step equations",
      "summary": "Solve equations with x on both sides (5x + 3 = 2x + 15) and equations that need distributing first (3(x + 4) = 27, 2(x − 1) = x + 6).",
      "typicalGrade": 8,
      "standards": [
        "7.EE.B.4a",
        "8.EE.C.7b"
      ],
      "status": "draft",
      "prerequisites": [],
      "subskills": [
        {
          "id": "alg.multi-step.both-sides",
          "name": "x on both sides (5x + 3 = 2x + 15)",
          "prerequisites": [
            {
              "id": "alg.equations.two-step",
              "strength": "essential",
              "why": "After the x's are together it's a two-step equation."
            },
            {
              "id": "alg.expressions.like-terms",
              "strength": "essential",
              "why": "Moving 2x across combines it with 5x."
            }
          ]
        },
        {
          "id": "alg.multi-step.distribute",
          "name": "Distribute first (3(x + 4) = 27)",
          "prerequisites": [
            {
              "id": "alg.expressions.distribute",
              "strength": "essential"
            },
            {
              "id": "alg.equations.two-step",
              "strength": "essential"
            }
          ]
        }
      ]
    },
    {
      "id": "alg.inequalities",
      "name": "Solve inequalities",
      "summary": "Solve one- and two-step inequalities (2x − 5 ≥ 7), including flipping the sign when multiplying or dividing by a negative number (−2x + 5 > 11 -> x < −3).",
      "typicalGrade": 7,
      "standards": [
        "7.EE.B.4b",
        "6.EE.B.8"
      ],
      "status": "draft",
      "prerequisites": [],
      "subskills": [
        {
          "id": "alg.inequalities.solve",
          "name": "Solve an inequality like an equation (2x − 5 ≥ 7)",
          "prerequisites": [
            {
              "id": "alg.equations.two-step",
              "strength": "essential"
            }
          ]
        },
        {
          "id": "alg.inequalities.flip",
          "name": "Flip the sign when multiplying or dividing by a negative (−3x < 12 -> x > −4)",
          "prerequisites": [
            {
              "id": "alg.inequalities.solve",
              "strength": "essential"
            },
            {
              "id": "int.mult-div.divide",
              "strength": "essential"
            }
          ]
        }
      ]
    },
    {
      "id": "alg.evaluate",
      "name": "Evaluate expressions",
      "summary": "Put numbers in for the letters and find the value: 3x + 2 when x = 4, x² when x = −3, formulas like A = lw.",
      "typicalGrade": 6,
      "standards": [
        "6.EE.A.2c"
      ],
      "status": "draft",
      "prerequisites": [],
      "subskills": [
        {
          "id": "alg.evaluate.substitute",
          "name": "Put in a number (3x + 2 when x = 4)",
          "prerequisites": [
            {
              "id": "alg.order-ops.no-parens",
              "strength": "essential"
            },
            {
              "id": "alg.exponents.evaluate",
              "strength": "essential",
              "why": "Some have x²."
            }
          ]
        },
        {
          "id": "alg.evaluate.negative",
          "name": "Put in a negative number (10 − x when x = −2; x² when x = −3)",
          "prerequisites": [
            {
              "id": "alg.evaluate.substitute",
              "strength": "essential"
            },
            {
              "id": "int.mult-div.multiply",
              "strength": "essential"
            },
            {
              "id": "int.add-sub.subtract",
              "strength": "essential"
            },
            {
              "id": "alg.exponents.negative-base",
              "strength": "supporting",
              "why": "(−3)² = 9."
            }
          ]
        },
        {
          "id": "alg.evaluate.two-letters",
          "name": "Two letters and formulas (3a − 2b; A = lw)",
          "prerequisites": [
            {
              "id": "alg.evaluate.substitute",
              "strength": "essential"
            }
          ]
        }
      ]
    },
    {
      "id": "alg.inequality-graphs",
      "name": "Graph inequalities",
      "summary": "Graph x > 3 or −2 ≥ x on a number line (open and closed dots, which way to shade), write the inequality a graph shows, and graph compound inequalities (−2 < x ≤ 4; x < −1 or x ≥ 3), solving first when needed.",
      "typicalGrade": 7,
      "standards": [
        "6.EE.B.8",
        "7.EE.B.4b",
        "HSA.CED.A.1"
      ],
      "status": "draft",
      "prerequisites": [],
      "subskills": [
        {
          "id": "alg.inequality-graphs.graph",
          "name": "Graph an inequality on a number line",
          "prerequisites": [
            {
              "id": "alg.inequalities.solve",
              "strength": "essential"
            },
            {
              "id": "int.add-sub.same-sign",
              "strength": "supporting",
              "why": "Reading negative numbers on the line."
            }
          ]
        },
        {
          "id": "alg.inequality-graphs.read",
          "name": "Write the inequality a graph shows",
          "prerequisites": [
            {
              "id": "alg.inequality-graphs.graph",
              "strength": "essential"
            }
          ]
        },
        {
          "id": "alg.inequality-graphs.compound",
          "name": "Graph compound inequalities (and / or)",
          "prerequisites": [
            {
              "id": "alg.inequality-graphs.graph",
              "strength": "essential"
            }
          ]
        }
      ]
    }
  ]
}
